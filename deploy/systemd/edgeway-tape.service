[Unit]
Description=EdgeWay bant yayinci (kayitli saati dongude yayinlar)
After=network-online.target

[Service]
User=edgeway
EnvironmentFile=/etc/edgeway/edgeway.env
ExecStart=/bin/sh -c 'for c in cam1 cam19; do \
  [ -f /var/lib/edgeway/tape/$c.mp4 ] && \
  ffmpeg -nostdin -loglevel warning -re -stream_loop -1 \
    -i /var/lib/edgeway/tape/$c.mp4 -an -c copy \
    -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/${c}tape & \
done; wait'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
